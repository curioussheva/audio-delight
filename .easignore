# ----------------------------------------------------------------------------
# PristineAudio - EAS Ignore (Optimized for SDK 36 & Native Modules)
# ----------------------------------------------------------------------------

# Dependencies & Cache
node_modules/
.yarn/
.pnp.*
yarn-error.log

# Expo & Build Artifacts (EAS will generate its own)
.expo/
.expo-shared/
dist/
web-build/

# --- Android Specific (Bare Workflow) ---
# JANGAN ignore folder android karena berisi file .kt kustom Anda.
# Tapi abaikan file sampah hasil build lokal:
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/generated/
android/.cxx/
android/.externalNativeBuild/
android/*.iml
android/app/*.iml

# Pengecualian: Kita butuh debug.keystore agar build tidak error
!android/app/debug.keystore

# --- iOS Specific ---
ios/Pods/
ios/build/
ios/DerivedData/
ios/Podfile.lock

# Environment & Secrets 
# (EAS Secrets sebaiknya diatur di dashboard expo.dev, bukan di file .env)
.env
.env.local
.env.*.local
!.env.example

# Temporary & Migration Files (PENTING: Jangan upload 400+ file sampah)
temp/
temp_migration/
*.tmp
*.temp
*.backup
MIGRATION_REPORT.txt

# IDE & OS Garbage
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# Logs & Tests
*.log
coverage/
__tests__/
*.test.ts
*.spec.ts

# --- EAS Config Preservation ---
# Pastikan file konfigurasi utama tidak ter-ignore
!package.json
!app.json
!eas.json
!tsconfig.json
!metro.config.js
!babel.config.js
