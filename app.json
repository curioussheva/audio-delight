{
  "expo": {
    "name": "PristineAudio",
    "slug": "pristine-audio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pristineaudio",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pristineaudio.app",
      "infoPlist": {
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0A1628"
      },
      "package": "com.pristineaudio.app",
      "versionCode": 1,
      "permissions": [
        "MODIFY_AUDIO_SETTINGS",
        "RECORD_AUDIO",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "WAKE_LOCK",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "imageWidth": 1080,
          "resizeMode": "cover",
          "backgroundColor": "#0A1628",
          "dark": {
            "image": "./assets/images/splash.png",
            "backgroundColor": "#0A1628"
          }
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow PristineAudio to access your music files.",
          "savePhotosPermission": "Allow PristineAudio to save audio files.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "expo-document-picker",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24,
            "buildToolsVersion": "36.0.0",
            "kotlinVersion": "2.0.21",
            "extraMavenRepos": [
              "../../node_modules/react-native-track-player/android/repo"
            ]
          },
          "ios": {
            "deploymentTarget": "15.1",
            "useFrameworks": "static"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "tsconfigPaths": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "62e1e6e9-9171-497b-b0f1-832a6d3e1424"
      }
    },
    "owner": "curioussheva"
  }
}
 