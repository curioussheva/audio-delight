{
  "expo": {
    "name": "PristineAudio",
    "slug": "pristine-audio",
    "version": "1.0.37",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pristineaudio",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pristineaudio.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio",
          "fetch"
        ]
      }
    },
    "android": {
      "package": "com.pristineaudio.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0A1628"
      },
      "permissions": [
        "MODIFY_AUDIO_SETTINGS",
        "RECORD_AUDIO",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "WAKE_LOCK",
        "RECEIVE_BOOT_COMPLETED",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.INTERNET",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "MANAGE_EXTERNAL_STORAGE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "intentFilters": [
        {
          "action": "android.hardware.usb.action.USB_DEVICE_ATTACHED"
        }
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "resizeMode": "cover",
          "backgroundColor": "#040B13",
          "imageWidth": 1280,
          "dark": {
            "image": "./assets/images/icon.png",
            "backgroundColor": "#040B13"
          }
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow PristineAudio to access your music files.",
          "savePhotosPermission": "Allow PristineAudio to save audio files.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "expo-document-picker",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24,
            "buildToolsVersion": "36.0.0",
            "kotlinVersion": "2.0.21",
            "newArchEnabled": true,
            "ndkVersion": "27.1.12297006",
            "usesCleartextTraffic": true,
            "extraMavenRepos": [
              "../../node_modules/react-native-track-player/android/repo"
            ]
          },
          "ios": {
            "deploymentTarget": "15.1",
            "useFrameworks": "static"
          }
        }
      ],
      [
        "expo-router",
        {
          "sitemap": false
        }
      ],
      "expo-background-task"
    ],
    "experiments": {
      "typedRoutes": false,
      "tsconfigPaths": true
    },
    "owner": "curioussheva",
    "extra": {
      "router": {
        "sitemap": false
      },
      "eas": {
        "projectId": "62e1e6e9-9171-497b-b0f1-832a6d3e1424"
      }
    }
  }
}
 