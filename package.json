{
  "name": "pristineaudio",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "type": "module",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "reset": "expo start -c",
    "build:dev": "eas build --platform android --profile development",
    "build:dev:ios": "eas build --platform ios --profile development",
    "build:preview": "eas build --platform all --profile preview",
    "build:prod": "eas build --platform all --profile production",
    "submit:android": "eas submit --platform android",
    "submit:ios": "eas submit --platform ios",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src --fix",
    "lint:check": "oxlint src",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "prepare": "husky install",
    "patch": "bash scripts/patch-pristine.sh",
    "download-oboe": "mkdir -p android/app/src/main/cpp/oboe && curl -L https://github.com/google/oboe/archive/refs/tags/1.9.0.tar.gz -o oboe.tar.gz && tar -xzf oboe.tar.gz --strip-components=1 -C android/app/src/main/cpp/oboe && rm oboe.tar.gz",
    "clean": "rm -rf node_modules pnpm-lock.yaml android/.gradle android/app/.cxx && pnpm install"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.2",
    "@expo/log-box": "^55.0.11",
    "@expo/metro-runtime": "~55.0.12",
    "@gorhom/bottom-sheet": "^4.6.4",
    "@missingcore/audio-metadata": "^1.3.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.1.2",
    "@react-navigation/drawer": "^7.5.0",
    "@react-navigation/native": "^7.1.33",
    "@shopify/flash-list": "2.0.2",
    "@shopify/react-native-skia": "2.4.18",
    "color-convert": "^2.0.1",
    "color-name": "^1.1.4",
    "expo": "~55.0.30",
    "expo-background-task": "~55.0.22",
    "expo-blur": "~55.0.18",
    "expo-build-properties": "~55.0.18",
    "expo-constants": "~55.0.17",
    "expo-dev-client": "~55.0.39",
    "expo-document-picker": "~55.0.17",
    "expo-file-system": "~55.0.26",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.18",
    "expo-image": "~55.0.11",
    "expo-linear-gradient": "~55.0.18",
    "expo-linking": "~55.0.17",
    "expo-media-library": "~55.0.21",
    "expo-notifications": "~55.0.27",
    "expo-router": "~55.0.18",
    "expo-sensors": "~55.0.19",
    "expo-sharing": "~55.0.24",
    "expo-splash-screen": "~55.0.25",
    "expo-status-bar": "~55.0.6",
    "expo-task-manager": "~55.0.20",
    "lucide-react-native": "^1.7.0",
    "moti": "^0.30.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-image-colors": "^2.6.0",
    "react-native-pager-view": "^8.0.0",
    "react-native-quick-sqlite": "^8.2.7",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-tab-view": "^3.5.2",
    "react-native-worklets": "0.7.4",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@eslint/js": "^10.0.1",
    "@react-native-community/cli": "^20.1.3",
    "@react-native/gradle-plugin": "0.83.6",
    "@types/react": "~19.2.10",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^10.0.3",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "oxlint": "^1.56.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-track-player",
          "react-native-quick-sqlite"
        ]
      }
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxlint --fix",
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=9.0.0"
  },
  "codegenConfig": {
    "name": "PristineAudioSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.pristineaudio.app"
    }
  },
  "packageManager": "pnpm@9.0.0"
}