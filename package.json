{
  "name": "pristineaudio",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "reset": "expo start -c",
    "prebuild": "expo prebuild --clean",
    "build:dev": "eas build --platform android --profile development",
    "build:dev:ios": "eas build --platform ios --profile development",
    "build:preview": "eas build --platform all --profile preview",
    "build:prod": "eas build --platform all --profile production",
    "submit:android": "eas submit --platform android",
    "submit:ios": "eas submit --platform ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "prepare": "husky install",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@missingcore/audio-metadata": "^1.3.0",
    "@react-native-async-storage/async-storage": "1.18.0",
    "@react-native-community/slider": "^5.1.2",
    "@react-navigation/drawer": "^7.9.4",
    "@resvg/resvg-js": "^2.6.2",
    "@shopify/flash-list": "2.0.2",
    "@shopify/react-native-skia": "2.2.12",
    "expo": "~54.0.0",
    "expo-av": "^16.0.8",
    "expo-blur": "^55.0.9",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.20",
    "expo-document-picker": "^55.0.8",
    "expo-file-system": "^55.0.10",
    "expo-font": "~14.0.11",
    "expo-haptics": "^55.0.8",
    "expo-linear-gradient": "^55.0.8",
    "expo-linking": "~8.0.11",
    "expo-media-library": "^55.0.9",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "fft-js": "^0.0.12",
    "immer": "^11.1.4",
    "jimp": "0.16.1",
    "music-metadata": "^11.12.2",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "^2.30.0",
    "react-native-reanimated": "^4.2.2",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.15.3",
    "react-native-track-player": "lovegaoshi/react-native-track-player",
    "react-native-worklets": "0.7.2",
    "sharp": "^0.34.5",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~19.1.10",
    "@types/react-native-draggable-flatlist": "^2.0.0",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "patch-package": "^8.0.0",
    "prettier": "^3.2.5",
    "typescript": "~5.9.2"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-track-player",
          "expo-av"
        ]
      }
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0",
    "yarn": ">=1.22.0"
  }
}
