{
  "name": "pristineaudio",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "type": "module",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "reset": "expo start -c",
    "prebuild": "expo prebuild --clean",
    "build:dev": "eas build --platform android --profile development",
    "build:dev:ios": "eas build --platform ios --profile development",
    "build:preview": "eas build --platform all --profile preview",
    "build:prod": "eas build --platform all --profile production",
    "submit:android": "eas submit --platform android",
    "submit:ios": "eas submit --platform ios",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src --fix",
    "lint:check": "oxlint src",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "prepare": "husky install",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^4.6.4",
    "@missingcore/audio-metadata": "^1.3.0",
    "@react-native-async-storage/async-storage": "1.21.0",
    "@react-native-community/slider": "5.0.1",
    "@react-navigation/drawer": "^7.9.4",
    "@shopify/flash-list": "1.6.4",
    "@shopify/react-native-skia": "1.3.10",
    "color-convert": "^2.0.1",
    "color-name": "^1.1.4",
    "expo": "~54.0.0",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "~0.12.5",
    "expo-constants": "~16.0.2",
    "expo-dev-client": "~4.0.4",
    "expo-document-picker": "~12.0.2",
    "expo-file-system": "~17.0.1",
    "expo-font": "~12.0.10",
    "expo-haptics": "~13.0.1",
    "expo-image": "~3.0.11",
    "expo-linking": "~6.3.1",
    "expo-router": "~3.5.23",
    "expo-sensors": "~13.0.9",
    "expo-sharing": "~12.0.1",
    "expo-splash-screen": "~0.27.5",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-native": "0.73.6",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.14.0",
    "react-native-pager-view": "6.3.0",
    "react-native-quick-sqlite": "^8.2.7",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.8.2",
    "react-native-screens": "~3.29.0",
    "react-native-svg": "^15.15.4",
    "react-native-tab-view": "^3.5.2",
    "react-native-track-player": "4.1.2",
    "react-native-worklets": "0.7.2",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@eslint/js": "^10.0.1",
    "@types/react": "~18.2.79",
    "@types/react-native-fs": "^2.13.0",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^10.0.3",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "oxlint": "^1.56.0",
    "patch-package": "^8.0.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-track-player"
        ]
      }
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxlint --fix",
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0",
    "yarn": ">=1.22.0"
  }
}
