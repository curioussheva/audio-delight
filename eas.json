{
  "cli": {
    "version": ">= 10.0.0",
    "appVersionSource": "remote",
    "requireCommit": false
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "20.19.4",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug",
        "resourceClass": "medium"
      },
      "ios": {
        "resourceClass": "m1-medium",
        "simulator": true
      },
      "env": {
        "APP_ENV": "development",
        "EAS_NO_VCS": "1",
        "EAS_NO_FINGERPRINT": "1",
        "EXPO_PUBLIC_APP_NAME": "PristineAudio (Dev)"
      },
      "cache": {
        "disabled": false,
        "key": "development-{{ checksum \"yarn.lock\" }}",
        "paths": [
          "node_modules",
          ".expo"
        ]
      },
      "channel": "development",
      "autoIncrement": true
    },
    "development-simulator": {
      "extends": "development",
      "node": "20.19.4",
      "ios": {
        "simulator": true,
        "resourceClass": "medium"
      }
    },
    "preview": {
      "distribution": "internal",
      "node": "20.19.4",
      "android": {
        "buildType": "apk",
        "resourceClass": "medium"
      },
      "env": {
        "APP_ENV": "preview",
        "EAS_NO_VCS": "1",
        "EAS_NO_FINGERPRINT": "1",
        "EXPO_NO_UPDATES": "1"
      },
      "channel": "preview",
      "autoIncrement": true,
      "hooks": {
        "pre-install": "./eas-hooks/eas-build-pre-install.sh"
      },
      "updates": {
        "enabled": false
      }
    },
    "production": {
      "distribution": "store",
      "node": "20.19.4",
      "android": {
        "buildType": "app-bundle",
        "resourceClass": "large"
      },
      "ios": {
        "resourceClass": "large"
      },
      "env": {
        "APP_ENV": "production",
        "EAS_NO_VCS": "1",
        "EAS_NO_FINGERPRINT": "1"
      },
      "channel": "production",
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal",
        "releaseStatus": "completed"
      }
    }
  }
}