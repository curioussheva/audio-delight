# ----------------------------------------------------------------------------
# PristineAudio - Gitignore (PNPM CLEAN)
# ----------------------------------------------------------------------------

# Dependencies
node_modules/

package-lock.json

# Expo & Metro
.expo/
.expo-shared/
dist/
web-build/
node_modules/.cache/
.metro/

# --- Android (KEEP SOURCE, IGNORE BUILD) ---
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/generated/
android/.cxx/
android/.externalNativeBuild/
android/*.iml
android/app/*.iml
android/captures/
android/.navigation/

# Keystore & Signing
*.jks
*.keystore
*.p8
*.p12
*.mobileprovision

!android/app/debug.keystore

# --- iOS ---
ios/Pods/
ios/build/
ios/DerivedData/
ios/*.xcworkspace
ios/*.xcuserdata
ios/*.xcresult
ios/Podfile.lock

# Build Artifacts
*.apk
*.aab
*.ipa
*.tar.gz
*.zip

# Environment
.env
.env.local
.env.*.local
!.env.example

# Temp & Migration
temp/
temp_migration/
*.tmp
*.temp
*.backup
MIGRATION_REPORT.txt

# IDE & OS
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# Logs
*.log
coverage/

# Tests DI-TRACK. Baris `__tests__/`, `*.test.ts`, `*.spec.ts` dihapus 2026-10-03:
# pola itu berasal dari era tanpa test di repo dan membuat suite Jest baru
# tidak pernah bisa di-commit maupun jalan di CI.

# TypeScript
*.tsbuildinfo

# Expo generated
expo-env.d.ts

# JANGAN ignore lockfile
!pnpm-lock.yamltmp/
*.backup_*
*.bak_*
tmp/
*.bak
*.bak_*

# graphify - output knowledge graph. Di-regenerate oleh `graphify update`,
# ~36 MB (graph.json 16 MB), tidak layak masuk riwayat git. Pola sama
# seperti persona/.gitignore.
graphify-out/

# Log dev server Metro (dibuat scripts/metro.sh). Besar dan regeneratif.
.metro.log
