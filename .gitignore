# ----------------------------------------------------------------------------
# PristineAudio - Gitignore (Optimized for Custom Native Modules)
# ----------------------------------------------------------------------------

# Dependencies
node_modules/
.yarn/
.pnp.*
yarn-error.log
package-lock.json
pnpm-lock.yaml

# Expo & Metro
.expo/
.expo-shared/
dist/
web-build/
node_modules/.cache/
.metro/

# --- Android Specific (Bare Workflow) ---
# Kita TIDAK meng-ignore folder /android karena ada Kotlin Native Modules.
# Namun, kita meng-ignore file hasil generate dan build:
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/generated/
android/.cxx/
android/.externalNativeBuild/
android/*.iml
android/app/*.iml
android/captures/
android/.navigation/

# Keystore & Signing
# Abaikan semua file jks/keystore untuk keamanan...
*.jks
*.keystore
*.p8
*.p12
*.mobileprovision

# ...KECUALI debug.keystore agar tim bisa langsung run-android
!android/app/debug.keystore

# --- iOS Specific ---
ios/Pods/
ios/build/
ios/DerivedData/
ios/*.xcworkspace
ios/*.xcuserdata
ios/*.xcresult
ios/Podfile.lock
ios/Pods/
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3

# Build Artifacts
*.apk
*.aab
*.ipa
*.tar.gz
*.zip
bin/
obj/

# Environment / Secret
.env
.env.local
.env.*.local
!.env.example

# Temporary & Migration Files (PENTING untuk PristineAudio)
temp/
temp_migration/
*.tmp
*.temp
*.backup
MIGRATION_REPORT.txt

# IDE & OS
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Logs & Tests
*.log
npm-debug.log*
yarn-debug.log*
coverage/
__tests__/
*.test.ts
*.spec.ts

# TypeScript
*.tsbuildinfo
# @generated expo-cli sync-2b81b286409207a5da26e14c78851eb30d8ccbdb
# The following patterns were generated by expo-cli 

# @generated expo-cli sync
expo-env.d.ts
# @end expo-cli

.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
