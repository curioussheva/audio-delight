# ----------------------------------------------------------------------------
# PristineAudio - Gitignore (PNPM CLEAN)
# ----------------------------------------------------------------------------

# Dependencies
node_modules/

package-lock.json

# Expo & Metro
.expo/
.expo-shared/
dist/
web-build/
node_modules/.cache/
.metro/

# --- Android (KEEP SOURCE, IGNORE BUILD) ---
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/generated/
android/.cxx/
android/.externalNativeBuild/
android/*.iml
android/app/*.iml
android/captures/
android/.navigation/

# Keystore & Signing
*.jks
*.keystore
*.p8
*.p12
*.mobileprovision

!android/app/debug.keystore

# --- iOS ---
ios/Pods/
ios/build/
ios/DerivedData/
ios/*.xcworkspace
ios/*.xcuserdata
ios/*.xcresult
ios/Podfile.lock

# Build Artifacts
*.apk
*.aab
*.ipa
*.tar.gz
*.zip

# Environment
.env
.env.local
.env.*.local
!.env.example

# Temp & Migration
temp/
temp_migration/
*.tmp
*.temp
*.backup
MIGRATION_REPORT.txt

# IDE & OS
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# Logs & Tests
*.log
coverage/
__tests__/
*.test.ts
*.spec.ts

# TypeScript
*.tsbuildinfo

# Expo generated
expo-env.d.ts

# JANGAN ignore lockfile
!pnpm-lock.yaml